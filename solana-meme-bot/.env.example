# === Modalità operativa (REAL FOMO di default) ===
TRADING_MODE=live
DRY_RUN=false

# === Mirror / Copy Trading (FOMO) ===
COPY_TRADING_ENABLED=true
MAX_PROFIT_SCAN_ENABLED=false
COPY_TRADE_SOL=0.15
COPY_MAX_WALLETS=50
COPY_POLL_INTERVAL_MS=3500
COPY_RECONNECT_MS=5000
COPY_LEADERBOARD_REFRESH_MS=300000
COPY_EMERGENCY_TAKE_PROFIT_PCT=300
COPY_EMERGENCY_STOP_LOSS_PCT=35
COPY_SELL_ANY_TRACKED=false
# address o address:Label separati da virgola (fallback se FOMO API down)
COPY_WALLET_SEEDS=
# Demo feed OFF — solo REAL
COPY_DEMO_FOMO_FEED=false
COPY_DEMO_INTERVAL_MS=45000

# === Risk ===
RISK_TOLERANCE=all
MAX_RISK_PCT=85

# === Budget (sovrascritto dal saldo FOMO reale in sessione) ===
BUDGET_SOL=1.0
MAX_POSITION_SOL=0.25
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_SOL=0.5
DEFAULT_SLIPPAGE_BPS=150
TAKE_PROFIT_PCT=100
STOP_LOSS_PCT=25
TRAILING_STOP_PCT=15
MOONSHOT_TAKE_PROFIT_PCT=200

# === Solana (opzionale — REAL FOMO non richiede private key) ===
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=
WALLET_PRIVATE_KEY=
SOLANA_TRACKER_API_KEY=

# === Venues ===
AXIOM_API_KEY=
AXIOM_API_BASE=https://api.axiom.example/v1
ANTHEM_API_KEY=
ANTHEM_API_BASE=https://api.anthem.example/v1
FOMO_API_KEY=
FOMO_API_BASE=https://prod-api.fomo.family
# Se Cloudflare blocca il datacenter, incolla cf_clearance dal browser loggato
FOMO_CF_CLEARANCE=
FOMO_CF_BM=
PUMPFUN_API_KEY=
PUMPFUN_API_BASE=https://frontend-api.pump.fun
PREFERRED_EXECUTION_VENUE=fomo

DEXSCREENER_BASE=https://api.dexscreener.com
TREND_POLL_INTERVAL_MS=60000
SCAN_INTERVAL_MS=45000
POSITION_POLL_INTERVAL_MS=15000

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3847
DASHBOARD_AUTH_TOKEN=change-me-dashboard-token
LOG_LEVEL=info
