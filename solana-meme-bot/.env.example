# === Modalità operativa ===
# paper = simulazione (default, consigliato). live = ordini reali (richiede chiavi e adapter configurati)
TRADING_MODE=paper
DRY_RUN=true

# === Sicurezza / Zero Dubbi ===
MIN_CONFIDENCE_SCORE=90
MIN_SAFETY_SCORE=90
ZERO_DOUBT_MODE=true

# === Budget & Risk ===
BUDGET_SOL=1.0
MAX_POSITION_SOL=0.25
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_SOL=0.5
DEFAULT_SLIPPAGE_BPS=150
TAKE_PROFIT_PCT=100
STOP_LOSS_PCT=25
TRAILING_STOP_PCT=15

# === Solana Wallet (MAI committare la chiave privata) ===
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
WALLET_PRIVATE_KEY=

# === Piattaforme: Axiom / Anthem / Pump.fun ===
AXIOM_API_KEY=
AXIOM_API_BASE=https://api.axiom.example/v1
ANTHEM_API_KEY=
ANTHEM_API_BASE=https://api.anthem.example/v1
PUMPFUN_API_KEY=
PUMPFUN_API_BASE=https://frontend-api.pump.fun
PREFERRED_EXECUTION_VENUE=axiom

# === Trend / Market data ===
DEXSCREENER_BASE=https://api.dexscreener.com
TREND_POLL_INTERVAL_MS=60000
SCAN_INTERVAL_MS=45000
POSITION_POLL_INTERVAL_MS=15000

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=

# === Dashboard ===
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3847
DASHBOARD_AUTH_TOKEN=change-me-dashboard-token

# === Logging ===
LOG_LEVEL=info
