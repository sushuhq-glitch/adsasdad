{
  "name": "solana-meme-bot",
  "version": "1.0.0",
  "description": "Bot H24 prudente per trading meme coin su Solana (Axiom / Anthem / Pump.fun) con motore Zero Dubbi, Telegram e Dashboard",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/ui && cp -r src/ui/public dist/ui/public",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dashboard": "tsx src/index.ts",
    "bot": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "solana",
    "meme-coin",
    "trading-bot",
    "telegram",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-telegram-bot-api": "^0.66.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/node-telegram-bot-api": "^0.64.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
